---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';

const todasGaleria = await getCollection('galeria');
const destacadas = todasGaleria
  .filter((entry) => entry.data.destacada === true)
  .sort((a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99));

const heroImages = destacadas.map((entry) => ({
  src: entry.data.imagen,
  alt: entry.data.alt,
}));

// Para el grid cuadrado: usar entre 6 y 10, mostramos hasta 9 en 3x3
const destacadasGrid = destacadas.slice(0, 9);
---
<Layout title="Inicio" description="Inti Fotografía — Servicios de fotografía profesional. Bodas, retratos y eventos.">
  <!-- Hero: carrusel a pantalla completa (100vh, ancho completo) + overlay -->
  {heroImages.length > 0 ? (
    <section class="relative w-full">
      <HeroCarousel images={heroImages} id="hero-carousel" intervalMs={5500} />
      <div class="absolute inset-0 flex flex-col justify-end items-center pb-16 md:pb-24 px-4 sm:px-6 lg:px-8 pointer-events-none">
        <div class="pointer-events-auto text-center max-w-3xl">
          <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-semibold text-white leading-tight tracking-tight drop-shadow-lg">
            Capturamos tu historia
          </h1>
          <p class="mt-4 text-lg md:text-xl text-inti-100 max-w-2xl mx-auto drop-shadow-md">
            Fotografía con sensibilidad y arte. Bodas, retratos y eventos con un estilo natural y atemporal.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a
              href="/planes"
              class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-inti-900 bg-white hover:bg-inti-100 rounded-md transition-colors shadow-lg"
            >
              Ver planes
            </a>
            <a
              href="/galeria"
              class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white border-2 border-white hover:bg-white/10 rounded-md transition-colors"
            >
              Ver galería
            </a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="w-full min-h-screen flex flex-col justify-center bg-inti-200/50 border-b border-inti-200 px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-semibold text-inti-800 leading-tight">Capturamos tu historia</h1>
        <p class="mt-6 text-lg text-inti-600">Fotografía con sensibilidad y arte.</p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a href="/planes" class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-inti-50 bg-inti-700 hover:bg-inti-800 rounded-md">Ver planes</a>
          <a href="/galeria" class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-inti-700 border border-inti-400 hover:border-inti-600 rounded-md">Ver galería</a>
        </div>
      </div>
    </section>
  )}

  <!-- Qué ofrecemos (debajo del carousel) -->
  <section class="w-full py-16 md:py-24 bg-inti-50">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-medium uppercase tracking-wider text-inti-500 mb-3">Servicios</p>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-inti-800 text-center mb-12 md:mb-14">
        Qué ofrecemos
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <article class="group bg-white border border-inti-200 rounded-xl p-8 text-center shadow-sm hover:shadow-md hover:border-inti-300 transition-all duration-300">
          <div class="w-12 h-12 mx-auto rounded-full bg-inti-100 flex items-center justify-center text-inti-600 group-hover:bg-inti-200 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="mt-5 font-serif text-xl font-semibold text-inti-800">Bodas</h3>
          <p class="mt-3 text-inti-600 text-sm leading-relaxed">
            Cobertura completa del día más importante. Reportaje y álbum con estilo editorial.
          </p>
          <a href="/planes#bodas" class="inline-block mt-4 text-sm font-medium text-inti-600 hover:text-inti-800 transition-colors">Ver planes →</a>
        </article>
        <article class="group bg-white border border-inti-200 rounded-xl p-8 text-center shadow-sm hover:shadow-md hover:border-inti-300 transition-all duration-300">
          <div class="w-12 h-12 mx-auto rounded-full bg-inti-100 flex items-center justify-center text-inti-600 group-hover:bg-inti-200 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="mt-5 font-serif text-xl font-semibold text-inti-800">Retratos</h3>
          <p class="mt-3 text-inti-600 text-sm leading-relaxed">
            Sesiones personales, familiares o profesionales en locación o estudio.
          </p>
          <a href="/planes#retratos" class="inline-block mt-4 text-sm font-medium text-inti-600 hover:text-inti-800 transition-colors">Ver planes →</a>
        </article>
        <article class="group bg-white border border-inti-200 rounded-xl p-8 text-center shadow-sm hover:shadow-md hover:border-inti-300 transition-all duration-300">
          <div class="w-12 h-12 mx-auto rounded-full bg-inti-100 flex items-center justify-center text-inti-600 group-hover:bg-inti-200 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="mt-5 font-serif text-xl font-semibold text-inti-800">Eventos</h3>
          <p class="mt-3 text-inti-600 text-sm leading-relaxed">
            Cumpleaños, aniversarios, bautizos y eventos corporativos.
          </p>
          <a href="/planes#eventos" class="inline-block mt-4 text-sm font-medium text-inti-600 hover:text-inti-800 transition-colors">Ver planes →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Fotos destacadas: grid cuadrado (3×3) a ancho completo -->
  {destacadasGrid.length > 0 && (
    <section class="w-full py-0 bg-inti-100 border-b border-inti-200">
      <div class="w-full max-w-[100vw] mx-auto px-0">
        <div class="w-full aspect-square grid grid-cols-3 grid-rows-3 gap-0.5 sm:gap-1">
          {destacadasGrid.map((entry) => (
            <a href="/galeria" class="block w-full h-full overflow-hidden bg-inti-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-inti-600 focus-visible:ring-inset">
              <img
                src={entry.data.imagen}
                alt={entry.data.alt}
                class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                loading="lazy"
              />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="w-full py-16 md:py-24 bg-inti-800 text-inti-100 border-t border-inti-700">
    <div class="w-full max-w-[100vw] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-3xl md:text-4xl font-semibold">
        ¿Listo para contar tu historia?
      </h2>
      <p class="mt-4 text-inti-300 max-w-xl mx-auto">
        Cuéntanos tu idea y te enviamos un presupuesto sin compromiso.
      </p>
      <a
        href="/contacto"
        class="inline-flex items-center justify-center mt-8 px-8 py-3 text-base font-medium text-inti-900 bg-inti-100 hover:bg-inti-50 rounded-md transition-colors"
      >
        Contactar
      </a>
    </div>
  </section>
</Layout>
